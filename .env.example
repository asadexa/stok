# Bu dosyayı .env olarak kopyala ve doldur. .env asla commit edilmez.
# cp .env.example .env

# ---------------------------------------------------------------------------
# VERİTABANI
# ---------------------------------------------------------------------------
# İKİ AYRI BAĞLANTI VAR. Karıştırmak D5 kararını geçersiz kılar.

# 1) Uygulamanın kullandığı bağlantı. RLS BUNA UYGULANIR.
#    Route handler'lar, sorgular, her şey bunu kullanır.
DATABASE_URL="postgresql://stok_app:stok_app_dev@localhost:5433/stok"

# 2) Sadece migration çalıştırmak için. Tabloların sahibi.
#    ASLA uygulama kodundan kullanma: bu rol RLS'i atlar.
MIGRATION_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/stok"

# BAĞLANTI HAVUZU (T117). Varsayılanlar TEK UZUN ÖMÜRLÜ SUNUCU için doğru
# ve yerelde dokunulmaması gerekiyor. Serverless'ta (Vercel) uygulama N
# eşzamanlı fonksiyon örneğine dağılıyor ve HER BİRİ kendi havuzunu açıyor:
# 20 örnek × 10 = 200 bağlantı, Supabase pooler'ın istemci sınırı o civarda
# ve aşılınca hata "too many connections" olarak KULLANICIYA düşüyor.
#   DB_POOL_MAX      örnek başına bağlantı (varsayılan 10; Vercel'de 1-3)
#   DB_IDLE_TIMEOUT  saniye; 0 = hiç kapatma (varsayılan). Serverless'ta
#                    sıfırdan büyük olmalı: donan örneğin bağlantısı aksi
#                    halde sunucu tarafında sonsuza kadar açık kalıyor.
# Bozuk değer sessizce yok sayılmıyor, kurulumda patlıyor.
# DB_POOL_MAX=""
# DB_IDLE_TIMEOUT=""

# ---------------------------------------------------------------------------
# UYGULAMA
# ---------------------------------------------------------------------------
# NODE_ENV BURADA TANIMLI DEĞİL, bilerek. Next.js onu kendisi ayarlıyor
# (dev'de development, `next build`/`next start`'ta production) ve .env'den
# gelen bir değer bunu eziyor: `NODE_ENV=development` ile yapılan bir
# `next build` "<Html> should not be imported outside of pages/_document"
# hatasıyla patlıyor. Ayrıca session.ts çerezin `secure` bayrağını buna
# bakarak veriyor — elle "development" yazılmış bir üretim sunucusu
# oturum çerezini düz HTTP üzerinden gönderirdi.
# APP_URL sadece bağlantı üretmek için değil: oturum çerezinin `Secure`
# bayrağı bu adresin şemasından türüyor (apps/web/src/server/session.ts).
# Üretimde https:// olmalı — http:// bırakılırsa oturum çerezi düz metin
# gider. Tanımsızsa `Secure` açık kabul edilir (fail closed).
APP_URL="http://localhost:3000"

# Oturum imzalama anahtarı (JWT). Üret:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Aşağıdaki değer yalnız yerel geliştirme için ve public repoda yazıyor: bu
# anahtarı bilen herkes kendine admin token'ı imzalayabilir. Üretim modu
# (`next start`, Vercel) bu değerle AÇILMAZ (T133); `pnpm demo` yeni bir
# .env oluştururken yerine rastgele bir anahtar yazar.
# Sunucu 32 karakterden kısa bir anahtarla açılmaz (varsayılana düşmez).
AUTH_SECRET="yerel-gelistirme-anahtari-degistir-32+"

# Mobil uygulamanın vurduğu API tabanı (Expo tarafında kullanılır)
EXPO_PUBLIC_API_URL="http://localhost:3000/api/v1"

# Sunucunun kabul ettiği en düşük mobil sürüm. Altındakiler 426 alır
# ve zorunlu güncelleme ekranı görür (PLAN.md T33).
MIN_CLIENT_VERSION="1.0.0"

# ---------------------------------------------------------------------------
# E-POSTA (T34 gün sonu raporu, T14 büyük Excel export)
# ---------------------------------------------------------------------------
SMTP_URL=""
REPORT_FROM_EMAIL="stok@example.com"

# ---------------------------------------------------------------------------
# CRON (T34)
# ---------------------------------------------------------------------------
# Zamanlayıcının POST /api/cron ucuna sunduğu paylaşılan sır.
#   Üret:  openssl rand -base64 32
#   Vur:   curl -X POST -H "Authorization: Bearer $CRON_SECRET" \
#              https://sunucu/api/cron
#
# TANIMSIZSA UÇ KAPALI (500) ve gün sonu raporu ile kritik stok taraması
# HİÇ ÇALIŞMAZ. "Tanımsızsa doğrulama yapma" varsayılanı seçilseydi, bu
# değişkeni eklemeyi unutan her kurulum, herkesin tetikleyebildiği bir
# e-posta gönderme ucu açardı.
# 32 karakterden kısa kabul edilmiyor: bu uç kaba kuvvet sayacına (T51)
# tabi değil, tek savunma sırrın tahmin edilemezliği.
CRON_SECRET=""

# ---------------------------------------------------------------------------
# PİLOT: TELEFON KAMERASIYLA BARKOD OKUTMA (WS-SCAN)
# ---------------------------------------------------------------------------
# "true" olunca /tara sayfası açılır; tanımsız, boş ya da "false" iken 404.
# Varsayılan KAPALI: sayfa girişsiz açılıyor ve pilotta tünelle internete
# çıkıyor. Yalnız true/false kabul edilir; başka değerle sunucu açılmaz.
# ENABLE_PHONE_SCANNER="true"

# ---------------------------------------------------------------------------
# ÜRETİM NOTU
# ---------------------------------------------------------------------------
# Supabase'e geçerken:
#   - DATABASE_URL, transaction pooler'ı (port 6543) göstermeli
#   - postgres.js sürücüsü pgbouncer transaction modunda prepare:false ister
#     (PLAN.md D-1.4)
#   - stok_app rolü Supabase'de elle oluşturulmalı, db/init/01-roles.sql
#     sadece yerel container'da otomatik çalışır

# ---------------------------------------------------------------------------
# TESTLER
# ---------------------------------------------------------------------------
# Entegrasyon testleri ayrı bir veritabanı gerektirmiyor: yukarıdaki iki
# bağlantı dizesinin veritabanı adını değiştirip kendi test veritabanlarını
# (stok_test_db, stok_test_core) her koşuda sıfırdan kuruyorlar.
# Yani `stok` veritabanındaki geliştirme verisi testlerden etkilenmez.
