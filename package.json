{
  "name": "stok",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "db:up": "docker compose up -d && node scripts/wait-for-db.mjs",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d && node scripts/wait-for-db.mjs",
    "db:logs": "docker compose logs -f db",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "demo": "node scripts/demo.mjs",
    "dev": "pnpm --filter @stok/web run dev",
    "seed": "pnpm --filter @stok/db run seed",
    "migrate": "pnpm --filter @stok/db run migrate"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
