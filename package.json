{
  "name": "stok",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:reset": "docker compose down -v && docker compose up -d && node scripts/wait-for-db.mjs",
    "db:up": "docker compose up -d && node scripts/wait-for-db.mjs",
    "demo": "node scripts/demo.mjs",
    "dev": "pnpm --filter @stok/web run dev",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "migrate": "pnpm --filter @stok/db run migrate",
    "seed": "pnpm --filter @stok/db run seed",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "typescript": "^5.7.3"
  }
}
