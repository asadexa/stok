# Üretim/staging şablonu (compose.production.yml). Sunucuda .env.production
# adıyla kopyala, doldur ve yalnız sahibine okunur yap:
#   cp .env.production.example .env.production && chmod 600 .env.production
# .env.production ASLA commit edilmez ve imaja girmez (.gitignore, .dockerignore).
# Bütün değerler compose'a `--env-file .env.production` ile verilir.
#
# Bu dosyada GERÇEK DEĞER YOK. Boş bırakılan zorunlu bir değişkenle compose
# başlamaz; uygulama da örnek ya da kısa AUTH_SECRET ile açılmaz (T133).

# ---------------------------------------------------------------------------
# VERİTABANI — iki ayrı rol, iki ayrı parola (D5, docs/ADR/002)
# ---------------------------------------------------------------------------
# Parolalar URL-GÜVENLİ olmalı: compose onları bağlantı adresine olduğu gibi
# yazıyor. Üret (64 onaltılık karakter):
#   openssl rand -hex 32
#
# Sahip rolü (postgres). Yalnız `tools` servisine (migration, init,
# tenant:create) verilir; uygulama konteyneri bunu görmez.
POSTGRES_PASSWORD=""
# Uygulama rolü (stok_app, RLS'e tabi). Yalnız veri dizini boşken rol bu
# parolayla yaratılır (db/production/005-app-role.sh). Sonradan değişirse önce
# veritabanında `ALTER ROLE stok_app PASSWORD ...`, sonra burası.
STOK_APP_DB_PASSWORD=""

# ---------------------------------------------------------------------------
# UYGULAMA
# ---------------------------------------------------------------------------
# Dışarıdan görünen adres; https:// ile. Oturum çerezinin Secure bayrağı
# bunun şemasından türüyor (apps/web/src/server/session.ts).
APP_URL="https://stok.example.com"

# Oturum imzalama anahtarı, en az 32 karakter. Üret:
#   openssl rand -base64 32
AUTH_SECRET=""

# Telefon tarayıcısı compose'da sabit KAPALI (ENABLE_PHONE_SCANNER=false);
# burada açılamaz (T167, ARC-14).

# Mobil istemci alt sınırı (mobil henüz yok; varsayılan yeterli).
# MIN_CLIENT_VERSION="1.0.0"

# ---------------------------------------------------------------------------
# CRON — zamanlayıcı S1'de KURULMADI (T112, sonraki iş)
# ---------------------------------------------------------------------------
# Tanımsızken /api/cron 500 döner; gün sonu raporu ve kritik stok taraması
# çalışmaz. Zamanlayıcı kurulurken en az 32 karakterlik değerle doldurulur:
#   openssl rand -base64 32
CRON_SECRET=""

# ---------------------------------------------------------------------------
# E-POSTA (isteğe bağlı; yoksa gönderim anında hata verir)
# ---------------------------------------------------------------------------
SMTP_URL=""
REPORT_FROM_EMAIL=""

# ---------------------------------------------------------------------------
# İMAJ ETİKETİ (isteğe bağlı) — hangi sürümün çalıştığı `docker ps`'te görünsün
# ---------------------------------------------------------------------------
# STOK_IMAGE_TAG="1b759a6"
